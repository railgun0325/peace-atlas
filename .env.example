COMPOSE_PROJECT_NAME=japan-antiwar-intel
TZ=Asia/Tokyo

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=postgres
POSTGRES_PORT=55432

N8N_HOST=localhost
N8N_PORT=5782
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5782/
GENERIC_TIMEZONE=Asia/Tokyo
N8N_ENCRYPTION_KEY=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=0

EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Reddit ---
# Public JSON search and old.reddit.com HTML scraping (no auth required by default).
# Optional OAuth2 script-app credentials for reliable API access.
# Create a "script" app at https://www.reddit.com/prefs/apps to get these.
REDDIT_FETCH_COMMENTS=false
REDDIT_REQUEST_DELAY_SECONDS=2.5
REDDIT_MAX_QUERY_TERMS=15
REDDIT_SUBREDDITS=japan,okinawa,japanlife,newsokur
REDDIT_INCLUDE_OPTIONAL_SUBREDDITS=false
REDDIT_STOP_AFTER_FIRST_DEFAULT_HIT=true
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_ACCEPT_DEFAULT_LATEST_FALLBACK=true

QDRANT_URL=http://qdrant:6333
ANALYSIS_WORKER_PORT=8190

# Optional outbound proxy for containers. The one-click Windows launcher can
# provide this bridge when a proxy is running on the Windows host.
OUTBOUND_HTTP_PROXY=

# --- Instagram ---
# Instagram now requires login for ALL access (public profiles included).
# Uses instagrapi private API wrapper with session persistence.
# Proxy is read from PROXY_URL or OUTBOUND_HTTP_PROXY env vars above.
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
